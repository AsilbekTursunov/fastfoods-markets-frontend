# Base URL of your backend API. Leave empty to use the Vite dev proxy (/api -> VITE_PROXY_TARGET).
VITE_API_URL=
# Backend address used by the dev proxy (edit vite.config.ts proxy target if different)
VITE_PROXY_TARGET=http://localhost:8000
# true = work fully offline with in-browser mock data (localStorage). Set false once backend is ready.
VITE_USE_MOCK=true
